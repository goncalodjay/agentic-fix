---

<section id="servicios" class="relative bg-white px-6 py-28">
  <div class="mx-auto max-w-6xl">

    <!-- Header -->
    <div class="scroll-reveal mx-auto max-w-2xl text-center">
      <p class="mb-4 text-xs font-bold tracking-[0.16em] text-gold-500 uppercase">Soluciones integrales</p>
      <h2 class="font-display text-4xl font-extrabold text-bark-900 sm:text-5xl">
        Todo lo que tu empresa <span class="text-ember-500">necesita para crecer</span>
      </h2>
      <p class="mx-auto mt-5 text-lg leading-relaxed text-muted">
        Combinamos tecnología de punta con estrategias de marketing para que tu negocio escale de verdad.
      </p>
    </div>

    <!-- Tabs -->
    <div class="scroll-reveal mt-12 flex justify-center" data-delay="120">
      <div class="inline-flex rounded-full border border-cream-200 bg-cream-100 p-1.5">
        <button
          id="btn-tech"
          class="rounded-full px-6 py-2.5 text-sm font-bold transition-all duration-200"
        >
          Tecnología &amp; IA
        </button>
        <button
          id="btn-marketing"
          class="rounded-full px-6 py-2.5 text-sm font-bold transition-all duration-200 text-muted"
        >
          Marketing &amp; Growth
        </button>
      </div>
    </div>

    <!-- Tech Panel -->
    <div id="panel-tech" class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {techServices.map((s) => (
        <article class="group relative rounded-card border border-cream-200 bg-cream-50 p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-ember-300 hover:shadow-2xl hover:shadow-ember-500/10">
          <div class="mb-5 grid h-12 w-12 place-items-center rounded-xl bg-gradient-to-br from-ember-500/10 to-gold-500/10 text-ember-600 transition-all duration-300 group-hover:from-ember-600 group-hover:to-ember-500 group-hover:text-white">
            <span class="h-6 w-6 [&>svg]:h-6 [&>svg]:w-6" set:html={s.icon} />
          </div>
          <h3 class="font-display text-xl font-bold text-bark-900">{s.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-muted">{s.desc}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {s.tags.map((t) => (
              <span class="rounded-full bg-cream-100 px-3 py-1 text-xs font-semibold text-bark-700 transition-colors group-hover:bg-ember-50 group-hover:text-ember-700">
                {t}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- Marketing Panel -->
    <div id="panel-marketing" class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" style="display:none">
      {marketingServices.map((s) => (
        <article class="group relative rounded-card border border-cream-200 bg-cream-50 p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-ember-300 hover:shadow-2xl hover:shadow-ember-500/10">
          <div class="mb-5 grid h-12 w-12 place-items-center rounded-xl bg-gradient-to-br from-ember-500/10 to-gold-500/10 text-ember-600 transition-all duration-300 group-hover:from-ember-600 group-hover:to-ember-500 group-hover:text-white">
            <span class="h-6 w-6 [&>svg]:h-6 [&>svg]:w-6" set:html={s.icon} />
          </div>
          <h3 class="font-display text-xl font-bold text-bark-900">{s.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-muted">{s.desc}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {s.tags.map((t) => (
              <span class="rounded-full bg-cream-100 px-3 py-1 text-xs font-semibold text-bark-700 transition-colors group-hover:bg-ember-50 group-hover:text-ember-700">
                {t}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  const btnTech = document.getElementById('btn-tech')!;
  const btnMkt = document.getElementById('btn-marketing')!;
  const panelTech = document.getElementById('panel-tech')!;
  const panelMkt = document.getElementById('panel-marketing')!;

  const ACTIVE = ['bg-white', 'text-bark-900', 'shadow-sm'];
  const INACTIVE = ['text-muted'];

  function activate(activeBtn: HTMLElement, inactiveBtn: HTMLElement, show: HTMLElement, hide: HTMLElement) {
    activeBtn.classList.add(...ACTIVE);
    activeBtn.classList.remove(...INACTIVE);
    inactiveBtn.classList.remove(...ACTIVE);
    inactiveBtn.classList.add(...INACTIVE);

    hide.style.display = 'none';
    show.style.opacity = '0';
    show.style.transform = 'translateY(10px)';
    show.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
    show.style.display = 'grid';

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        show.style.opacity = '1';
        show.style.transform = 'translateY(0)';
      });
    });
  }

  // Initial state
  btnTech.classList.add(...ACTIVE);

  btnTech.addEventListener('click', () => activate(btnTech, btnMkt, panelTech, panelMkt));
  btnMkt.addEventListener('click', () => activate(btnMkt, btnTech, panelMkt, panelTech));
</script>
