---
const steps = [
  {
    n: '01',
    title: 'Entendemos',
    desc: 'Nos metemos en tu negocio: analizamos procesos, detectamos los cuellos de botella reales y definimos exactamente dónde la IA genera impacto medible, no promesas vacías.',
  },
  {
    n: '02',
    title: 'Diseñamos',
    desc: 'Definimos la arquitectura a medida: qué modelos, qué integraciones, qué costo operativo. Te presentamos un plan claro con alcance, tiempos y criterio técnico antes de escribir una línea de código.',
  },
  {
    n: '03',
    title: 'Programamos',
    desc: 'Construimos, probamos y desplegamos. Todo código propio, hecho para tu caso concreto — sin depender de plantillas ni de terceros que no conocen tu operación.',
  },
  {
    n: '04',
    title: 'Crecemos',
    desc: 'Una vez en producción, no te dejamos solo: medimos resultados, ajustamos los modelos y mejoramos la solución mes a mes para que siga generando valor a medida que tu negocio crece.',
  },
];
---

<section id="proceso" class="grain relative overflow-hidden bg-bark-900 px-6 py-28 text-cream-50">
  <div class="glow h-[400px] w-[400px] bg-ember-500/20" style="top:10%; left:-120px;"></div>

  <div class="relative mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-4 text-xs font-bold tracking-[0.16em] text-gold-300 uppercase">Nuestro método</p>
      <h2 class="font-display text-4xl font-extrabold sm:text-5xl">
        Un proceso claro que <span class="text-molten">garantiza resultados</span>
      </h2>
      <p class="mx-auto mt-5 text-lg leading-relaxed text-cream-200/70">
        No tenemos un portfolio de clientes que mostrar todavía — tenemos algo mejor: un método
        probado donde cada etapa tiene un entregable concreto y vos sabés exactamente qué está pasando.
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s) => (
          <div class="relative rounded-card border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm transition-colors hover:border-ember-400/40">
            <div class="font-display text-5xl font-black text-ember-500/30">{s.n}</div>
            <h3 class="mt-3 font-display text-xl font-bold text-cream-50">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-200/60">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
