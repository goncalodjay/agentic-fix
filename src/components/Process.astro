---
const steps = [
  {
    n: '01',
    title: 'Entendemos',
    desc: 'Nos metemos en tu negocio: analizamos procesos, detectamos los cuellos de botella reales y definimos exactamente dónde la tecnología genera impacto medible, no promesas vacías.',
  },
  {
    n: '02',
    title: 'Diseñamos',
    desc: 'Definimos la estrategia a medida: qué tecnología, qué acciones de marketing, qué costo operativo. Un plan claro con alcance, tiempos y criterio técnico antes de ejecutar nada.',
  },
  {
    n: '03',
    title: 'Ejecutamos',
    desc: 'Construimos, probamos y desplegamos. Todo hecho para tu caso concreto — sin depender de plantillas ni de terceros que no conocen tu operación.',
  },
  {
    n: '04',
    title: 'Crecemos',
    desc: 'Una vez en producción, no te dejamos solo: medimos resultados, optimizamos campañas y ajustamos la solución mes a mes para que siga generando valor real.',
  },
];
---

<section id="proceso" class="grain relative overflow-hidden bg-bark-900 px-6 py-28 text-cream-50">
  <div class="glow h-[450px] w-[450px] bg-ember-500/15" style="top:10%; left:-140px;"></div>
  <div class="glow h-[300px] w-[300px] bg-gold-500/10" style="bottom:10%; right:-100px;"></div>

  <div class="relative mx-auto max-w-6xl">
    <div class="scroll-reveal mx-auto max-w-2xl text-center">
      <p class="mb-4 text-xs font-bold tracking-[0.16em] text-gold-300 uppercase">Nuestro método</p>
      <h2 class="font-display text-4xl font-extrabold sm:text-5xl">
        Un proceso claro que <span class="text-molten">garantiza resultados</span>
      </h2>
      <p class="mx-auto mt-5 text-lg leading-relaxed text-cream-200/70">
        Cada etapa tiene un entregable concreto y vos sabés exactamente qué está pasando
        — sin promesas vacías ni cajas negras.
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <div
            class="scroll-reveal relative rounded-card border border-white/10 bg-white/[0.04] p-7 backdrop-blur-sm transition-all duration-300 hover:border-ember-400/50 hover:bg-white/[0.07]"
            data-delay={String(i * 100)}
          >
            <div class="font-display text-5xl font-black text-ember-500/25">{s.n}</div>
            <h3 class="mt-3 font-display text-xl font-bold text-cream-50">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-200/60">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
