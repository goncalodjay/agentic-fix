---
const links = [
  { href: '#diferencial', label: 'Diferencial' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="fixed top-0 z-50 w-full">
  <nav
    class="mx-auto mt-4 flex max-w-6xl items-center justify-between rounded-full px-5 py-3 glass"
    style="width: calc(100% - 2rem);"
  >
    <a href="#top" class="flex items-center gap-2.5">
      <span
        class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-ember-500 to-gold-500 font-display text-lg font-black text-white shadow-lg shadow-ember-500/30"
        >F</span
      >
      <span class="font-display text-lg font-extrabold tracking-tight text-bark-900">FIX</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="text-sm font-semibold text-muted transition-colors hover:text-bark-900"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="#contacto"
      class="rounded-full bg-bark-900 px-5 py-2.5 text-sm font-bold text-cream-50 transition-transform hover:-translate-y-0.5 hover:bg-ember-600"
    >
      Hablemos
    </a>
  </nav>
</header>
